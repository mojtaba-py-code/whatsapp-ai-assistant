# Copy to .env and fill in. Every variable is optional unless marked REQUIRED.
# Never commit the real .env (it is git-ignored).

# --- runtime ------------------------------------------------------------------------------
# dev | prod. In prod (the default) an empty WA_APP_SECRET makes every webhook POST fail
# with 401; only dev may skip the signature check, and it logs a warning when it does.
WA_ENV=dev
# DEBUG | INFO | WARNING | ERROR. Message bodies are never logged at any level.
WA_LOG_LEVEL=INFO
# Folder with business.toml and knowledge/{es,pt,en}/*.md
WA_DATA_DIR=data
# SQLite file (created with its folder on first start). ":memory:" keeps nothing.
WA_DB_PATH=var/wa_assistant.db

# --- WhatsApp Cloud API (Meta developer app) ----------------------------------------------
# REQUIRED for the webhook: any long random string; type the same value in Meta's webhook form.
WA_VERIFY_TOKEN=
# REQUIRED in prod: App settings > Basic > App secret. Used to check X-Hub-Signature-256.
WA_APP_SECRET=
# REQUIRED to reply: temporary token from WhatsApp > API Setup, or a System User token.
WA_ACCESS_TOKEN=
# REQUIRED to reply: the "Phone number ID" shown in WhatsApp > API Setup (not the number).
WA_PHONE_NUMBER_ID=
# Graph API version used for outbound calls.
WA_GRAPH_VERSION=v23.0
WA_GRAPH_BASE_URL=https://graph.facebook.com
# Timeout of each Graph API call, in seconds (one retry on 5xx and connection errors).
WA_HTTP_TIMEOUT_SECONDS=10
# Mark each incoming message as read (blue ticks).
WA_MARK_AS_READ=true

# --- operations -------------------------------------------------------------------------------
# The business owner's WhatsApp number, international format with country code. Gets
# handoff alerts, booking alerts and relayed messages, and may send /bot on and /reply.
WA_OWNER_PHONE=
# Bearer token for GET /admin/bookings and GET /admin/handoffs. Empty = admin API disabled (404).
WA_ADMIN_TOKEN=
# How long the bot stays silent after a customer asks for a person.
WA_HANDOFF_TTL_HOURS=24
# Messages per minute per customer before the polite "slow down" reply. 0 disables the limit.
WA_RATE_LIMIT_PER_MINUTE=8

# --- answers -----------------------------------------------------------------------------------
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the offline extractive provider.
# anthropic = always Claude (the SDK may also find credentials outside ANTHROPIC_API_KEY).
# offline = never call an LLM.
WA_LLM_PROVIDER=auto
WA_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (sent as output_config.effort)
WA_LLM_EFFORT=low
WA_LLM_MAX_TOKENS=1024
# Server-side refusal fallbacks (beta "server-side-fallback-2026-07-01", fallbacks="default").
WA_LLM_FALLBACKS=true
# Previous question/answer pairs sent to the LLM with each question.
WA_HISTORY_TURNS=6
# Passages retrieved per question.
WA_RETRIEVAL_TOP_K=3
# Minimum BM25 score for the offline provider to answer (below it: "I don't know" + human),
# and below which retrieval also searches the documents of the other languages.
WA_OFFLINE_MIN_SCORE=1.5

# Read by the Anthropic SDK (no WA_ prefix). Leave empty to run fully offline.
ANTHROPIC_API_KEY=
